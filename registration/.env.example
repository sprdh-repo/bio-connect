# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
DATABASE_URL=postgres://bioconnect:local-development-only@localhost:55432/bioconnect?sslmode=disable
BASE_URL=http://localhost:8080
LISTEN_ADDR=:8080
APP_ENV=development
REGISTRATION_ENABLED=false
LIVE_DELIVERY=false
STORAGE_DIR=./var/files
SBI_COLLECT_URL=
AWS_REGION=ap-south-1
S3_BUCKET=
# CIDR of the reverse proxy; only then is X-BioConnect-Client-IP trusted for throttling.
TRUSTED_PROXY_CIDR=
# Shared on-site device passcode. Use a memorable multi-word secret, separate from admin credentials.
OPS_KEY=
# Existing verified Zinvos identity. Do not substitute Bio Connect as sender name.
POSTMARK_FROM_ADDRESS=
POSTMARK_FROM_NAME=
POSTMARK_SERVER_TOKEN=
POSTMARK_STREAM=outbound
# Admin console campaigns; must be a Broadcasts stream with Postmark-managed unsubscribes.
POSTMARK_BROADCAST_STREAM=broadcast
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=
# Existing Zinvos WhatsApp sender and approved Bio Connect template. The pass
# template must declare a DOCUMENT header: the worker uploads the pass PDF and
# sends it as the header, with the pass link kept in the body as a fallback.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_API_VERSION=
META_TEMPLATE=
META_TEMPLATE_LANGUAGE=en
# Optional approved template for food passes, with the same DOCUMENT header and
# link parameter as META_TEMPLATE, whose wording says the pass is for meals only.
# Empty sends food passes with META_TEMPLATE; the PDF is still named FOOD-ONLY.
META_FOOD_TEMPLATE=
# Separate approved AUTHENTICATION template with a COPY_CODE button for mobile OTP.
META_OTP_TEMPLATE=
META_OTP_TEMPLATE_LANGUAGE=en_US
# Moments provider credentials stay on this server and are never shipped in the mobile app.
MOMENTS_API_BASE=https://moments.mshiyaf.com/api/v1
MOMENTS_API_TOKEN=
# Provider API roots. Leave as-is in production; point at a stub for local delivery tests.
POSTMARK_API_BASE=https://api.postmarkapp.com
META_API_BASE=https://graph.facebook.com

# Optional store reviewer access for review@bioconnect.example.
# Set a private six-digit reusable code in production; empty disables access.
STORE_REVIEW_CODE=
