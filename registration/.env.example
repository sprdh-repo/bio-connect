# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
DATABASE_URL=postgres://bioconnect:local-development-only@localhost:55432/bioconnect?sslmode=disable
BASE_URL=http://localhost:8080
LISTEN_ADDR=:8080
APP_ENV=development
REGISTRATION_ENABLED=false
LIVE_DELIVERY=false
STORAGE_DIR=./var/files
SBI_COLLECT_URL=
AWS_REGION=ap-south-1
S3_BUCKET=
# CIDR of the reverse proxy; only then is X-BioConnect-Client-IP trusted for throttling.
TRUSTED_PROXY_CIDR=
# Existing verified Zinvos identity. Do not substitute Bio Connect as sender name.
POSTMARK_FROM_ADDRESS=
POSTMARK_FROM_NAME=
POSTMARK_SERVER_TOKEN=
POSTMARK_STREAM=outbound
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=
# Existing Zinvos WhatsApp sender and approved Bio Connect template. The pass
# template must declare a DOCUMENT header: the worker uploads the pass PDF and
# sends it as the header, with the pass link kept in the body as a fallback.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_API_VERSION=
META_TEMPLATE=
META_TEMPLATE_LANGUAGE=en
# Provider API roots. Leave as-is in production; point at a stub for local delivery tests.
POSTMARK_API_BASE=https://api.postmarkapp.com
META_API_BASE=https://graph.facebook.com
