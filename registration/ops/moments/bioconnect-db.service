[Unit]
Description=Bio Connect PostgreSQL 17 (container without a network; socket only)
After=docker.service
Requires=docker.service
[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
ExecStartPre=-/usr/bin/docker rm -f bioconnect-db
# --network none: no published port and no iptables rules on this shared host.
# Clients connect through the socket in /srv/bioconnect/pgsock. Debian, not
# Alpine: on this 3.10 kernel Docker's seccomp profile returns EPERM for newer
# syscalls and musl does not fall back, so the Alpine image cannot even initdb.
ExecStart=/usr/bin/docker run --rm --name bioconnect-db --network none \
  --memory 2g --cpus 2 --shm-size 256m \
  --env-file /etc/bioconnect/postgres.env \
  -v /srv/bioconnect/pgdata:/var/lib/postgresql/data \
  -v /srv/bioconnect/pgsock:/var/run/postgresql \
  --log-driver json-file --log-opt max-size=10m --log-opt max-file=5 \
  postgres:17
ExecStop=/usr/bin/docker stop -t 60 bioconnect-db
[Install]
WantedBy=multi-user.target
